# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# MySQL / phpMyAdmin Local & Remote Database Credentials
MYSQL_URL=mysql://avnadmin:your_password@your-db.aivencloud.com:18925/defaultdb?ssl-mode=REQUIRED
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_password
DB_HOST=your-db.aivencloud.com
DB_PORT=18925
DB_SSL_MODE=REQUIRED

# Email SMTP Settings (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_FROM=noreply@tulsimart.com

