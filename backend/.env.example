# Django Configuration
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://tulsi-mart.vercel.app,https://tulsimart.vercel.app
CSRF_TRUSTED_ORIGINS=https://tulsi-mart.vercel.app,https://tulsimart.vercel.app

# Aiven PostgreSQL Database Connection URL (Recommended for Production)
DATABASE_URL=postgres://avnadmin:your_password@your-db.aivencloud.com:18925/defaultdb?sslmode=require

# Alternative Individual Database Credentials (PostgreSQL / MySQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your_password
DB_HOST=your-db.aivencloud.com
DB_PORT=18925
DB_SSL_MODE=REQUIRED

# Email SMTP Settings (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_FROM=noreply@tulsimart.com


